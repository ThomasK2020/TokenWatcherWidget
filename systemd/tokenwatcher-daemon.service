# Template systemd utilisateur (install_local_widget.sh génère le chemin exact du poste)
[Unit]
Description=TokenWatcher Telemetry Daemon V4.2.0 MULTI-ENGINE
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/TokenWatcherWidget
ExecStart=%h/Projects/TokenWatcherWidget/.venv/bin/python3 src/tokenwatcher_daemon.py
Restart=always
RestartSec=2s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
